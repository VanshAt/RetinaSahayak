# RetinaSahayak Environment Configuration Template
# Duplicate this file to .env for local runtime overrides.

# App Environment
ENVIRONMENT=local
PROJECT_NAME="RetinaSahayak"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & Authentication (Replace with a strong random secret for production)
SECRET_KEY="YOUR_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (e.g., sqlite:///./retinasahayak.db or PostgreSQL URL)
DATABASE_URL="YOUR_DATABASE_URL"

# Storage Provider Abstraction: "LOCAL" or "GCS"
STORAGE_PROVIDER="LOCAL"
LOCAL_STORAGE_DIR="./storage"

# Google Cloud Platform (Optional for local demo - leave empty for 100% offline mode)
GCP_PROJECT_ID="YOUR_GCP_PROJECT_ID"
GCS_BUCKET_NAME="YOUR_GCS_BUCKET_NAME"
GOOGLE_APPLICATION_CREDENTIALS="YOUR_GOOGLE_APPLICATION_CREDENTIALS"

# Machine Learning & Inference Engine
USE_MOCK_INFERENCE=true
MODEL_WEIGHTS_PATH="./models/retinasahayak_efficientnet.pt"
IQA_SHARPNESS_THRESHOLD=100.0
IQA_MIN_LUMINANCE=28.0
IQA_MAX_LUMINANCE=230.0
UNCERTAINTY_CONFIDENCE_THRESHOLD=0.65
